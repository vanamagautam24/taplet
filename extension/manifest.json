{
  "manifest_version": 3,
  "name": "Rust Snips",
  "version": "0.2.1",
  "description": "Your local text shortcuts, powered by a small Rust engine. No account or background app.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "rust-snips@gautam.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'; base-uri 'none'"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["defaults.js", "schema.js", "engine.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["core.wasm"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "action": {
    "default_title": "Rust Snips",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "options_ui": { "page": "options.html?studio=0.2.1", "open_in_tab": true }
}
